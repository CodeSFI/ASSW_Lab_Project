# Entorno de la aplicacion mock (contenedor Podman rootless, rol app_node).
# Gestionado por Ansible; NO editar a mano. Contiene secretos (modo 0600).
MOCK_HTTP_PORT={{ app_http_port }}
MOCK_HOST={{ ansible_hostname | default(inventory_hostname) }}
MOCK_DB_HOST={{ mock_db_host }}
MOCK_DB_PORT={{ mock_db_port }}
MOCK_DB_NAME={{ mock_db_name }}
MOCK_DB_USER={{ mock_db_user }}
MOCK_DB_PASSWORD={{ mock_db_password }}